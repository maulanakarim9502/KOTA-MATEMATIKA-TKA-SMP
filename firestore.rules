rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    function isTeacherAdmin() {
      return isSignedIn() && request.auth.token.email == 'maulanakarim9502@gmail.com';
    }

    function isValidUserProgress(data) {
      return data.keys().hasAll([
          'uid',
          'name',
          'school',
          'studentClass',
          'email',
          'solvedCount',
          'completedChapters',
          'level',
          'totalScore',
          'progress',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'name',
          'school',
          'studentClass',
          'email',
          'solvedCount',
          'completedChapters',
          'level',
          'totalScore',
          'progress',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.school is string && data.school.size() <= 60
        && data.studentClass is string && data.studentClass.size() <= 20
        && data.email is string && data.email.size() <= 100
        && data.solvedCount is int && data.solvedCount >= 0 && data.solvedCount <= 55
        && data.completedChapters is int && data.completedChapters >= 0 && data.completedChapters <= 11
        && data.level is int && data.level >= 1 && data.level <= 12
        && data.totalScore is int && data.totalScore >= 0 && data.totalScore <= 5000
        && data.progress is map && data.progress.size() <= 55
        && data.updatedAt == request.time;
    }

    function isValidWorldPlayer(data) {
      return data.keys().hasAll([
          'uid',
          'mapId',
          'name',
          'school',
          'studentClass',
          'avatarColor',
          'x',
          'y',
          'z',
          'yaw',
          'isMoving',
          'level',
          'solvedQuestions',
          'completedChapters',
          'activeChapterId',
          'isOnline',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'mapId',
          'name',
          'school',
          'studentClass',
          'avatarColor',
          'x',
          'y',
          'z',
          'yaw',
          'isMoving',
          'level',
          'solvedQuestions',
          'completedChapters',
          'activeChapterId',
          'isOnline',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == request.auth.uid
        && data.mapId is string && data.mapId == 'tka-city-main'
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 40
        && data.school is string && data.school.size() <= 60
        && data.studentClass is string && data.studentClass.size() <= 20
        && data.avatarColor is int && data.avatarColor >= 0 && data.avatarColor <= 16777215
        && data.x is number && data.x >= -85 && data.x <= 85
        && data.y is number && data.y >= -15 && data.y <= 45
        && data.z is number && data.z >= -85 && data.z <= 85
        && data.yaw is number && data.yaw >= -20 && data.yaw <= 20
        && data.isMoving is bool
        && data.level is int && data.level >= 1 && data.level <= 12
        && data.solvedQuestions is int && data.solvedQuestions >= 0 && data.solvedQuestions <= 55
        && data.completedChapters is int && data.completedChapters >= 0 && data.completedChapters <= 11
        && data.activeChapterId is int && data.activeChapterId >= 0 && data.activeChapterId <= 11
        && data.isOnline is bool
        && data.updatedAt == request.time;
    }

    function isValidStudentSubmission(data, submissionId) {
      return data.keys().hasAll([
          'id',
          'uid',
          'studentName',
          'school',
          'studentClass',
          'email',
          'chapterId',
          'chapterTitle',
          'questionNumber',
          'workNotes',
          'fileName',
          'hasAttachment',
          'folderPath',
          'serverFilePath',
          'driveFileId',
          'driveUrl',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'uid',
          'studentName',
          'school',
          'studentClass',
          'email',
          'chapterId',
          'chapterTitle',
          'questionNumber',
          'workNotes',
          'fileName',
          'hasAttachment',
          'folderPath',
          'serverFilePath',
          'driveFileId',
          'driveUrl',
          'createdAt'
        ])
        && data.id is string && data.id == submissionId
        && data.uid is string && data.uid == request.auth.uid
        && data.studentName is string && data.studentName.size() >= 1 && data.studentName.size() <= 40
        && data.school is string && data.school.size() <= 60
        && data.studentClass is string && data.studentClass.size() <= 20
        && data.email is string && data.email.size() <= 100
        && data.chapterId is int && data.chapterId >= 1 && data.chapterId <= 11
        && data.chapterTitle is string && data.chapterTitle.size() >= 1 && data.chapterTitle.size() <= 80
        && data.questionNumber is int && data.questionNumber >= 1 && data.questionNumber <= 5
        && data.workNotes is string && data.workNotes.size() <= 2000
        && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 140
        && data.hasAttachment is bool
        && data.folderPath is string && data.folderPath.size() >= 1 && data.folderPath.size() <= 180
        && data.serverFilePath is string && data.serverFilePath.size() <= 260
        && data.driveFileId is string && data.driveFileId.size() <= 128
        && data.driveUrl is string && data.driveUrl.size() <= 300
        && data.createdAt == request.time;
    }

    function isValidTeacherDriveConfig(data, settingId) {
      return data.keys().hasAll([
          'id',
          'folderId',
          'folderUrl',
          'folderName',
          'teacherEmail',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'folderId',
          'folderUrl',
          'folderName',
          'teacherEmail',
          'updatedAt'
        ])
        && data.id is string && data.id == settingId && data.id == 'teacherDrive'
        && data.folderId is string && data.folderId.size() <= 128
        && data.folderUrl is string && data.folderUrl.size() <= 256
        && data.folderName is string && data.folderName.size() <= 120
        && data.teacherEmail is string && data.teacherEmail == 'maulanakarim9502@gmail.com'
        && data.updatedAt == request.time;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (isOwner(userId) || isTeacherAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeacherAdmin());
      allow create: if isValidId(userId) && isSignedIn() && isOwner(userId) && isValidUserProgress(incoming());
      allow update: if isValidId(userId)
        && isSignedIn()
        && isOwner(userId)
        && isValidUserProgress(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name',
          'school',
          'studentClass',
          'email',
          'solvedCount',
          'completedChapters',
          'level',
          'totalScore',
          'progress',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /worldPlayers/{playerId} {
      allow get: if isValidId(playerId) && isSignedIn() && existing().mapId == 'tka-city-main';
      allow list: if isSignedIn() && resource.data.mapId == 'tka-city-main' && resource.data.isOnline == true;
      allow create: if isValidId(playerId) && isSignedIn() && isOwner(playerId) && isValidWorldPlayer(incoming());
      allow update: if isValidId(playerId)
        && isSignedIn()
        && isOwner(playerId)
        && isValidWorldPlayer(incoming())
        && incoming().uid == existing().uid
        && incoming().mapId == existing().mapId
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'x',
            'y',
            'z',
            'yaw',
            'isMoving',
            'isOnline',
            'updatedAt'
          ])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'school',
            'studentClass',
            'avatarColor',
            'x',
            'y',
            'z',
            'yaw',
            'isMoving',
            'level',
            'solvedQuestions',
            'completedChapters',
            'activeChapterId',
            'isOnline',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(playerId) && isSignedIn() && isOwner(playerId);
    }

    match /submissions/{submissionId} {
      allow get: if isValidId(submissionId) && isSignedIn() && (existing().uid == request.auth.uid || isTeacherAdmin());
      allow list: if isSignedIn() && (resource.data.uid == request.auth.uid || isTeacherAdmin());
      allow create: if isValidId(submissionId) && isSignedIn() && isValidStudentSubmission(incoming(), submissionId);
      allow update: if false;
      allow delete: if isValidId(submissionId) && isSignedIn() && (existing().uid == request.auth.uid || isTeacherAdmin());
    }

    match /settings/{settingId} {
      allow get: if isValidId(settingId) && settingId == 'teacherDrive' && isSignedIn();
      allow create: if isValidId(settingId)
        && settingId == 'teacherDrive'
        && isTeacherAdmin()
        && isValidTeacherDriveConfig(incoming(), settingId);
      allow update: if isValidId(settingId)
        && settingId == 'teacherDrive'
        && isTeacherAdmin()
        && isValidTeacherDriveConfig(incoming(), settingId)
        && incoming().id == existing().id
        && incoming().teacherEmail == existing().teacherEmail
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'folderId',
          'folderUrl',
          'folderName',
          'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
